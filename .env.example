# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend API
DATABASE_URL="postgresql://route_longevity_user:CHANGE_ME@127.0.0.1:5432/route_longevity"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
PORT="4000"

# Public app URL, used for password reset links.
APP_URL="https://routelongevity.com"
CORS_ORIGIN="https://routelongevity.com,https://www.routelongevity.com"
COOKIE_SECURE="true"
DATABASE_SSL="false"
