# Agent AI
# GEMINI_API_KEY is required for real Gemini API calls.
AI_PROVIDER="gemini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-2.5-flash"
AGENT_MAX_TOKENS="800"
AGENT_REQUEST_TIMEOUT_MS="30000"

# Backend API
DATABASE_URL="postgresql://route_longevity_user:CHANGE_ME@127.0.0.1:5432/route_longevity"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
PORT="4000"

# Public app URL, used for password reset links.
APP_URL="https://routelongevity.com"
CORS_ORIGIN="https://routelongevity.com,https://www.routelongevity.com"
COOKIE_SECURE="true"
DATABASE_SSL="false"

# Optional: when set, signup verification codes are emailed with Resend.
# Without RESEND_API_KEY, emails are printed in PM2 logs for testing.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Route Longevity <verify@routelongevity.com>"

# Optional: when set, contact forms and applications send admin notifications.
ADMIN_NOTIFY_EMAIL="admin@routelongevity.com"
